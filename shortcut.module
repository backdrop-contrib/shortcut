<?php

if (!defined('SHORTCUT_DEFAULT_ACTIVE_COLOR')) {
  define('SHORTCUT_DEFAULT_ACTIVE_COLOR', '#0073BD');
}

/**
 * @file
 * Provides the Shortcut sticky toolbar.
 */

/**
 * Returns the default color used for the active set badge.
 */
function shortcut_toolbar_default_color() {
  return SHORTCUT_DEFAULT_ACTIVE_COLOR;
}

/**
 * Normalizes a hex color string and applies a fallback when needed.
 */
function shortcut_toolbar_normalize_color($value, $fallback = NULL) {
  $value = is_string($value) ? trim($value) : '';

  if ($value === '') {
    return isset($fallback) ? $fallback : '';
  }

  if ($value[0] !== '#') {
    $value = '#' . $value;
  }

  if (preg_match('/^#[0-9a-fA-F]{6}$/', $value)) {
    return strtoupper($value);
  }

  return isset($fallback) ? $fallback : '';
}

/**
 * Element validator ensuring color inputs store normalized hex values.
 */
function shortcut_user_set_color_validate($element, &$form_state, $form) {
  $normalized = shortcut_toolbar_normalize_color($element['#value'], shortcut_toolbar_default_color());
  form_set_value($element, $normalized, $form_state);
}

/**
 * Implements hook_theme().
 */
function shortcut_theme($existing, $type, $theme, $path) {
  return array(
    'shortcut_user_shortcuts_manage_links_form' => array(
      'render element' => 'form',
    ),
  );
}

/**
 * Implements hook_preprocess_page().
 */
function shortcut_preprocess_page(&$variables) {
  static $toolbar_added = FALSE;

  // Only modify full HTML responses, and ensure we only inject once.
  if ($toolbar_added || !backdrop_is_html()) {
    return;
  }

  if (!shortcut_user_can_use_toolbar()) {
    return;
  }

  $admin_bar_active = shortcut_admin_bar_is_active();

  // Normalize page class collection so we can safely append our markers.
  if (!isset($variables['classes']) || $variables['classes'] === NULL) {
    $variables['classes'] = array();
  }
  elseif (is_string($variables['classes'])) {
    $variables['classes'] = preg_split('/\s+/', trim($variables['classes']));
  }

  // Signal to CSS that the toolbar is present so body spacing can adjust.
  if (!in_array('shortcut-toolbar-active', $variables['classes'])) {
    $variables['classes'][] = 'shortcut-toolbar-active';
  }
  if (!in_array('shortcut-toolbar-visible', $variables['classes'])) {
    $variables['classes'][] = 'shortcut-toolbar-visible';
  }

  if ($admin_bar_active && !in_array('shortcut-toolbar-with-admin-bar', $variables['classes'])) {
    $variables['classes'][] = 'shortcut-toolbar-with-admin-bar';
  }

  // Make sure the toolbar library is present in the page assets.
  backdrop_add_library('shortcut', 'shortcut_bar', TRUE);

  $toolbar_build = shortcut_toolbar_build();
  $toolbar_build['#weight'] = 101;

  if (isset($variables['page_bottom']) && is_array($variables['page_bottom'])) {
    $variables['page_bottom']['shortcut_toolbar'] = $toolbar_build;
  }
  else {
    $markup = backdrop_render($toolbar_build);
    $variables['page_bottom'] = isset($variables['page_bottom']) ? $variables['page_bottom'] . $markup : $markup;
  }
  $toolbar_added = TRUE;
}

/**
 * Implements hook_permission().
 */
function shortcut_permission() {
  return array(
    'manage own shortcuts' => array(
      'title' => t('Manage own shortcuts'),
      'description' => t('Allow users to manage their personal shortcut sets.'),
    ),
    'administer shortcuts' => array(
      'title' => t('Administer all shortcuts'),
      'description' => t('Manage shortcut sets for all users.'),
    ),
  );
}

